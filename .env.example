# Timezone + schedule
TIMEZONE=America/New_York
SEND_HOUR=6
SEND_MINUTE=0

# Email (Gmail SMTP recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM=your_gmail@gmail.com
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Optional: subject prefix
EMAIL_SUBJECT_PREFIX=[AI Newsletter]

# Optional: local Ollama summarizer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Optional tuning (keep temperature low for stable bullet formatting)
OLLAMA_TEMPERATURE=0.2
# OLLAMA_TOP_P=0.9
# OLLAMA_REPEAT_PENALTY=1.1
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_PREDICT=512
# Max chars passed to Ollama before 2-pass summarization kicks in
OLLAMA_MAX_INPUT_CHARS=20000

# Optional: CrewAI summarizer (uses OpenAI)
# Note: CrewAI is not installed by default in requirements.txt. Install it yourself if you want this mode.
# USE_CREWAI=false
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL_NAME=gpt-4o

# Optional: audio fallback for videos without captions
# If you put audio files into AUDIO_CACHE_DIR manually, leave ENABLE_AUDIO_FETCHER=false.
ENABLE_AUDIO_FETCHER=false
AUDIO_CACHE_DIR=.cache/audio
ASR_ENGINE=faster_whisper
WHISPER_MODEL=small
# If ENABLE_AUDIO_FETCHER is true, delete fetched audio artifacts after transcription.
CLEANUP_FETCHED_AUDIO=true

# Optional: point to ffmpeg explicitly if PATH isn't set (Homebrew usually installs here on Apple Silicon)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
